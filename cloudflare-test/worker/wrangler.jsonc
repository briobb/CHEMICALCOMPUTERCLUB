{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ccc-checkout-test",
	"main": "src/index.js",
	"compatibility_date": "2026-08-02",
	"vars": {
		"SITE_URL": "https://chemicalcomputerclub.com",
		"ALLOWED_ORIGIN": "https://chemicalcomputerclub.com,http://chemicalcomputerclub.com,https://briobb.github.io",
		"CHECKOUT_SUCCESS_PATH": "/cloudflare-test/thank-you.html",
		"CHECKOUT_CANCEL_PATH": "/cloudflare-test/index-cart-test.html?checkout=cancelled"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "ccc-orders-test",
			"database_id": "7b2e3569-2cc2-4dbf-aed2-ec4021829040"
		}
	],
	"send_email": [
		{
			"name": "ORDER_EMAIL",
			"destination_address": "chemicalcomputerclub@gmail.com",
			"allowed_sender_addresses": [
				"orders@chemicalcomputerclub.com"
			]
		}
	],
	"env": {
		"production": {
			"name": "ccc-checkout",
			"vars": {
				"SITE_URL": "https://chemicalcomputerclub.com",
				"ALLOWED_ORIGIN": "https://chemicalcomputerclub.com",
				"CHECKOUT_SUCCESS_PATH": "/thank-you.html",
				"CHECKOUT_CANCEL_PATH": "/?checkout=cancelled"
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "ccc-orders-production",
					"database_id": "b4705c04-cf14-4088-8a0d-7491db352757"
				}
			],
			"send_email": [
				{
					"name": "ORDER_EMAIL",
					"destination_address": "chemicalcomputerclub@gmail.com",
					"allowed_sender_addresses": [
						"orders@chemicalcomputerclub.com"
					]
				}
			]
		}
	}
}
